# Melt and Pivot

df = pd.DataFrame({
    "country": ["USA","USA","India","india"],
    "year" : [2020, 2021, 2020, 2021],
    "sales" : [100, 130, 90, 22],
    "profit":[23,26,20,10],
    "tax": [12,45,65,87]
})

melted_df = df.melt(
    id_vars = ["country","year"],
    value_vars = ["sales", "profit"],
    var_name = "metrics",
    value_name = "value"
)

melted_df.pivot(
    index = ["country","year"],
    columns = "metrics",
    values = "value"
)



df


